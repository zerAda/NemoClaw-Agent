# Nemoclaw + Career Agent — Environment Variables
# Copy this file to .env and fill in real values before running docker compose up

# === Shared: Google Gemini ===
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# === NemoClaw: Telegram Bot ===
# Get from: @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# === NemoClaw: OpenClaw Auth ===
# Your Telegram numeric user ID (from @userinfobot)
NEMO_AUTH_USER_ID=your-telegram-user-id-here
# Pairing code — set any random secret string
NEMO_PAIRING_CODE=your-pairing-code-here

# === CD Pipeline: VPS Deployment ===
# Set as GitHub Actions repository variables (not secrets)
# VPS_HOST is the VPS IP or hostname
# VPS_SSH_KEY is the private key secret in GitHub Actions

# === Legacy (kept for compatibility) ===
DOMAIN_NAME=nemoclaw.local
NODE_ENV=production
